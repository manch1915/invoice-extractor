{
	frankenphp
	admin off
	auto_https off
}

:8080 {
	root * /app/public
	encode zstd gzip

	@assets path /build/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	php_server
}
