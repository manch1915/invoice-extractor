# hidden files and folders inside the allowed paths
**/.*
!.npmrc

# rebuilt inside the image or created at runtime
public/build
public/hot
storage/app/private/*
storage/app/public/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php
database/database.sqlite
