APP_NAME="Invoice Extractor"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
# Proxies allowed to set X-Forwarded-For/Proto (defaults to the private ranges Docker uses)
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# PostgreSQL in compose; local development can use DB_CONNECTION=sqlite
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=invoices
DB_USERNAME=invoices
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=local
DOCUMENTS_DISK=local

# Document reader (Python worker). The token must match on both sides.
WORKER_URL=http://worker:8001
WORKER_TOKEN=
WORKER_ENGINE=auto

# Optional: any OpenAI-compatible API. Without a key the worker reads with layout rules.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_DAILY_TOKEN_LIMIT=300000

REVIEW_THRESHOLD=0.8
BASE_CURRENCY=RUB

# Public demo: one-click sign-in, sample documents loaded on first start, nightly reset.
DEMO_MODE=false
DEMO_ALLOW_INTEGRATIONS=false

# Mailbox for forwarded invoices (optional)
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_ADDRESS=

# Google Sheets export: OAuth client from Google Cloud console (optional)
# Redirect URI: {APP_URL}/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Xero export: app from developer.xero.com (optional)
# Redirect URI: {APP_URL}/integrations/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

HORIZON_DOCUMENT_PROCESSES=2
