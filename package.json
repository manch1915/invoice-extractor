{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint resources/js",
        "format": "prettier --write resources/js resources/css",
        "format:check": "prettier --check resources/js resources/css",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@inertiajs/vite": "^3.9.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.13.0",
        "eslint-plugin-vue": "^10.11.1",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@fontsource-variable/ibm-plex-sans": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@inertiajs/vue3": "^3.9.1",
        "@vueuse/core": "^15.0.0",
        "lucide-vue-next": "^1.0.0",
        "vue": "^3.5.44",
        "ziggy-js": "^2.6.5"
